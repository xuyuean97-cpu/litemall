.goods-attr {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03); /* 微弱的投影，更立体 */
}

/* 标题：“商品参数” */
.goods-attr .t {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}
/* 给标题加个科技蓝色的左侧小竖条装饰 */
.goods-attr .t::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  background: #1989fa;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* 参数列表外框：加个浅色边框，做成表格感觉 */
.goods-attr .l {
  border: 2rpx solid #f0f2f5;
  border-radius: 12rpx;
  overflow: hidden; /* 防止内容溢出圆角 */
}

/* 单行参数：彻底废弃原版的 float，改用现代 Flex 布局 */
.goods-attr .item {
  display: flex;
  align-items: flex-start; /* 顶部对齐，防止右侧文字多时错位 */
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f2f5;
  background-color: #ffffff;
}
/* 去掉最后一行的下划线 */
.goods-attr .item:last-child {
  border-bottom: none;
}
/* 🔥重点优化：斑马纹底色！师傅眼睛看久了不会串行 */
.goods-attr .item:nth-child(even) {
  background-color: #fafbfc;
}

/* 左侧：属性名（如：接口类型） */
.goods-attr .left {
  width: 160rpx; /* 固定宽度，保证所有冒号完美对齐 */
  font-size: 26rpx;
  color: #888888;
  flex-shrink: 0; /* 防止被右侧内容挤压变形 */
  line-height: 40rpx;
}

/* 右侧：属性值（如：eDP 30 pin） */
.goods-attr .right {
  flex: 1; /* 自动占满剩余空间 */
  font-size: 28rpx;
  color: #333333;
  font-weight: 500; /* 参数值微微加粗，突出核心信息 */
  line-height: 40rpx;
  word-break: break-all; /* 如果有很长的全英文型号，允许自动换行，绝不截断 */
}

