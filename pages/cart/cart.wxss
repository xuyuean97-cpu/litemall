page {
  height: 100%;
  min-height: 100%;
  background: linear-gradient(180deg, #ab956d 0%, #f5f5f5 200rpx);
}

.container {
  background: transparent;
  width: 100%;
  height: auto;
  min-height: 100%;
  overflow: hidden;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 服务承诺栏 */
.service-policy {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(171, 149, 109, 0.15) 0%, rgba(201, 184, 150, 0.1) 100%);
  padding: 0 40rpx;
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.service-policy .item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8B6914;
  font-weight: 500;
}

.service-policy .item::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #ab956d 100%);
  border-radius: 50%;
  margin-right: 10rpx;
}

/* 未登录状态 */
.no-login {
  width: 100%;
  height: auto;
  margin: 0 auto;
  padding-top: 100rpx;
}

.no-login .c {
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.no-login .c text {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.no-login button {
  width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(171, 149, 109, 0.3);
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 空购物车状态 */
.no-cart {
  width: 100%;
  height: auto;
  margin: 0 auto;
  padding-top: 80rpx;
}

.no-cart .c {
  width: 100%;
  height: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.no-cart .c text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  line-height: 48rpx;
}

.no-cart .c text:first-child {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

/* 购物车主体 */
.cart-view {
  width: 100%;
  height: auto;
  overflow: hidden;
}

.cart-view .list {
  height: auto;
  width: 100%;
  overflow: hidden;
  margin-bottom: 140rpx;
}

.cart-view .group-item {
  height: auto;
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* 商品列表项 */
.cart-view .item {
  height: auto;
  width: 100%;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-view .item:last-child {
  border-bottom: none;
}

.cart-view .item .van-checkbox {
  flex-shrink: 0;
  margin-right: 20rpx;
}

.cart-view .item .cart-goods {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-view .item .img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f8f8f8;
  overflow: hidden;
  flex-shrink: 0;
}

.cart-view .item .info {
  flex: 1;
  height: auto;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-view .item .t {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.cart-view .item .name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cart-view .item .num {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.cart-view .item .attr {
  font-size: 24rpx;
  color: #999;
  background: #f8f8f8;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}

.cart-view .item .b {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-view .item .price {
  font-size: 32rpx;
  color: #ab956d;
  font-weight: 600;
}

/* 数量选择器 */
.cart-view .item .selnum {
  display: none;
}

.cart-view .item.edit .selnum {
  display: flex;
  align-items: center;
  height: 56rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
}

.selnum .cut,
.selnum .add {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background: #f8f8f8;
}

.selnum .cut:active,
.selnum .add:active {
  background: #eee;
}

.selnum .number {
  width: 80rpx;
  height: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border: none;
  background: #fff;
}

/* 编辑模式 */
.cart-view .item.edit .t {
  display: none;
}

.cart-view .item.edit .attr {
  text-align: left;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #666;
  background: transparent;
  padding: 0;
}

.cart-view .item.edit .b {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-view .item.edit .price {
  font-size: 30rpx;
}

/* 促销信息 */
.cart-view .group-item .header {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.cart-view .promotion {
  float: left;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.cart-view .promotion .tag {
  border: 1rpx solid #ab956d;
  height: 36rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  margin-right: 12rpx;
  color: #ab956d;
  font-size: 22rpx;
  border-radius: 6rpx;
}

.cart-view .promotion .txt {
  color: #333;
  font-size: 26rpx;
}

.cart-view .get {
  float: right;
  height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #ab956d;
}

/* 底部操作栏 */
.cart-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.cart-bottom .van-checkbox {
  flex-shrink: 0;
  margin-right: 12rpx;
}

.cart-bottom .van-checkbox .van-checkbox__label {
  font-size: 26rpx;
  color: #666;
}

.cart-bottom .total {
  flex: 1;
  font-size: 32rpx;
  color: #ab956d;
  font-weight: 600;
}

/* 操作按钮区域 */
.action_btn_area {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action_btn_area .edit,
.action_btn_area .sure {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  font-weight: 500;
}

.action_btn_area .delete {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  font-weight: 500;
}

.action_btn_area .checkout {
  width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ab956d 0%, #8B6914 100%);
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(171, 149, 109, 0.3);
}

/* 授权按钮 */
.auth_btn {
  position: fixed;
  top: 55vh;
  left: 10vw;
  width: 80vw;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  box-shadow: 0 8rpx 24rpx rgba(171, 149, 109, 0.3);
  font-weight: 500;
}
