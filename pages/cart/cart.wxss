page {
  height: 100%;
  min-height: 100%;
  background: #f5f7fa;
}

.container {
  background: #f5f7fa;
  width: 100%;
  height: auto;
  min-height: 100%;
  overflow: hidden;
  padding-bottom: 140rpx;
}

/* 服务政策 */
.service-policy {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: linear-gradient(135deg, #e8f0fe 0%, #f0f4ff 100%);
  padding: 20rpx 24rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.policy-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-top: 32rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.login-btn {
  margin-top: 48rpx;
  width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

/* 购物车列表 */
.cart-list {
  padding: 0 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.checkbox-wrapper {
  margin-right: 20rpx;
}

.goods-card {
  display: flex;
  flex: 1;
  min-width: 0;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 20rpx;
  min-width: 0;
  padding: 8rpx 0;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #1a73e8;
  font-weight: 600;
}

.goods-count {
  font-size: 26rpx;
  color: #666;
}

/* 数量控制器 */
.quantity-control {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 24rpx;
  overflow: hidden;
}

.qty-btn {
  width: 56rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

.qty-btn.minus {
  color: #999;
}

.qty-btn.plus {
  color: #1a73e8;
}

.qty-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

/* 底部结算栏 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.footer-left {
  display: flex;
  align-items: center;
}

.select-all-text {
  font-size: 26rpx;
  color: #333;
  margin-left: 8rpx;
}

.footer-center {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-right: 20rpx;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  color: #1a73e8;
  font-weight: 700;
  margin-left: 8rpx;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.edit-btn {
  background: #f5f7fa;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.delete-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

.checkout-btn {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
  min-width: 180rpx;
}

/* 编辑模式 */
.cart-item.edit-mode .goods-count {
  display: none;
}

.auth_btn {
  position: fixed;
  top: 55vh;
  left: 10vw;
  width: 80vw;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
}
