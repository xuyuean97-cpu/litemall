<view class="container">
  <!-- 未登录状态 -->
  <view class="no-login" wx:if="{{!hasLogin}}">
    <view class="empty-state">
      <van-icon name="user-circle-o" size="120rpx" color="#ddd" />
      <text class="empty-title">还没有登录</text>
      <text class="empty-desc">登录后可同步购物车商品</text>
      <button class="login-btn" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view class='login' wx:else>
    <!-- 顶部服务政策 -->
    <view class="service-policy">
      <view class="policy-item">
        <van-icon name="certificate" size="28rpx" color="#1a73e8" />
        <text>30天无忧退货</text>
      </view>
      <view class="policy-item">
        <van-icon name="clock-o" size="28rpx" color="#1a73e8" />
        <text>48小时快速退款</text>
      </view>
      <view class="policy-item">
        <van-icon name="logistics" size="28rpx" color="#1a73e8" />
        <text>满88元免邮费</text>
      </view>
    </view>

    <!-- 空购物车 -->
    <view class="no-cart" wx:if="{{cartGoods.length <= 0}}">
      <view class="empty-state">
        <van-icon name="shopping-cart-o" size="140rpx" color="#ddd" />
        <text class="empty-title">购物车空空如也</text>
        <text class="empty-desc">去添加点什么吧</text>
      </view>
    </view>

    <!-- 购物车列表 -->
    <view class="cart-view" wx:else>
      <view class="cart-list">
        <view class="cart-item {{isEditCart ? 'edit-mode' : ''}}" wx:for="{{cartGoods}}" wx:key="id">
          <view class="checkbox-wrapper">
            <van-checkbox value="{{ item.checked }}" bind:change="checkedItem" data-item-index="{{index}}" checked-color="#1a73e8"></van-checkbox>
          </view>
          <view class="goods-card">
            <image class="goods-img" src="{{item.picUrl}}" mode="aspectFill"></image>
            <view class="goods-info">
              <text class="goods-name">{{item.goodsName}}</text>
              <text class="goods-spec">{{item.specifications||'默认规格'}}</text>
              <view class="goods-bottom">
                <text class="goods-price">¥{{item.price}}</text>
                <view class="quantity-control" wx:if="{{isEditCart}}">
                  <view class="qty-btn minus" bindtap="cutNumber" data-item-index="{{index}}">-</view>
                  <text class="qty-num">{{item.number}}</text>
                  <view class="qty-btn plus" bindtap="addNumber" data-item-index="{{index}}">+</view>
                </view>
                <text class="goods-count" wx:else>x{{item.number}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部结算栏 -->
      <view class="cart-footer">
        <view class="footer-left">
          <van-checkbox value="{{ checkedAllStatus }}" bind:change="checkedAll" checked-color="#1a73e8">
            <text class="select-all-text">全选({{cartTotal.checkedGoodsCount}})</text>
          </van-checkbox>
        </view>
        <view class="footer-center" wx:if="{{!isEditCart}}">
          <text class="total-label">合计:</text>
          <text class="total-price">¥{{cartTotal.checkedGoodsAmount}}</text>
        </view>
        <view class="footer-actions">
          <view class="action-btn edit-btn" bindtap="editCart">{{!isEditCart ? '编辑' : '完成'}}</view>
          <view class="action-btn delete-btn" bindtap="deleteCart" wx:if="{{isEditCart}}">删除({{cartTotal.checkedGoodsCount}})</view>
          <view class="action-btn checkout-btn" bindtap="checkoutOrder" wx:if="{{!isEditCart}}">去结算</view>
        </view>
      </view>
    </view>
  </view>
</view>
