page {
  background: #f5f7fa;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部装饰背景 */
.login-header {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 450rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -50rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: 50rpx;
  left: -80rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.logo-wrapper {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 登录卡片 */
.login-card {
  margin: -60rpx 30rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.login-title {
  text-align: center;
  margin-bottom: 48rpx;
}

.title-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.title-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 登录按钮 */
.login-btns {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wx-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border-radius: 48rpx;
  border: none;
  padding: 0;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn .btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 16rpx 0;
}

.divider-line {
  flex: 1;
  height: 1px;
  background: #eee;
}

.divider-text {
  font-size: 24rpx;
  color: #ccc;
}

.account-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: #fff;
  border: 2rpx solid #1a73e8;
  border-radius: 48rpx;
  padding: 0;
}

.account-login-btn::after {
  border: none;
}

.account-login-btn .btn-text {
  font-size: 30rpx;
  color: #1a73e8;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 登录优势 */
.login-benefits {
  display: flex;
  justify-content: space-around;
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1px solid #f5f5f5;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

/* 底部协议 */
.login-footer {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}

.footer-link {
  font-size: 24rpx;
  color: #1a73e8;
}
