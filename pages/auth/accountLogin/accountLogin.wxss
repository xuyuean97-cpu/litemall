page {
  background: #f5f7fa;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 0 30rpx;
}

/* 顶部标题区域 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 48rpx;
}

.header-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #e8f0fe 0%, #d2e3fc 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #999;
}

/* 登录表单卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 28rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  height: 100rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input-wrapper:focus-within {
  background: #fff;
  border-color: #1a73e8;
  box-shadow: 0 0 0 4rpx rgba(26, 115, 232, 0.1);
}

.input-field {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
  margin-left: 20rpx;
}

.placeholder {
  color: #bbb;
  font-size: 28rpx;
}

/* 登录按钮 */
.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 48rpx;
  margin-top: 48rpx;
  border: none;
  padding: 0;
}

.login-btn::after {
  border: none;
}

.login-btn text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 8rpx;
}

/* 底部链接 */
.form-links {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.link-register text {
  color: #1a73e8;
}

.link-reset text {
  color: #999;
}

/* 安全提示 */
.security-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 48rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999;
}
