/* AI 客服聊天页面样式 - 优化版 */

/* ==================== 全局变量 ==================== */
page {
  --primary-color: #2563eb;
  --primary-dark: #1d4ed8;
  --primary-light: #3b82f6;
  --primary-gradient: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  --accent-color: #f59e0b;
  --accent-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  --bg-primary: #f8fafc;
  --bg-secondary: #ffffff;
  --bg-tertiary: #f1f5f9;
  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-muted: #94a3b8;
  --border-color: #e2e8f0;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.12);
  --shadow-primary: 0 4px 16px rgba(37, 99, 235, 0.25);
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  position: relative;
}

/* ==================== 消息列表 ==================== */
.message-list {
  flex: 1;
  overflow: hidden;
  padding: 32rpx 24rpx;
}

/* ==================== 欢迎卡片 ==================== */
.welcome-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  margin: 40rpx 16rpx 0;
  background: var(--bg-secondary);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

/* 装饰背景 */
.welcome-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(59, 130, 246, 0.04) 100%);
  border-radius: var(--radius-xl) var(--radius-xl) 50% 50%;
}

.welcome-avatar {
  width: 140rpx;
  height: 140rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-primary), 0 0 0 8rpx rgba(37, 99, 235, 0.1);
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.avatar-icon {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  height: 48rpx;
}

.ai-dot {
  width: 10rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.95);
  animation: ai-dot-wave 1.4s ease-in-out infinite;
}

.dot1 { height: 20rpx; animation-delay: 0s; }
.dot2 { height: 36rpx; animation-delay: 0.2s; }
.dot3 { height: 24rpx; animation-delay: 0.4s; }

@keyframes ai-dot-wave {
  0%, 60%, 100% { 
    transform: scaleY(1); 
    opacity: 0.7; 
  }
  30% { 
    transform: scaleY(1.5); 
    opacity: 1; 
  }
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.7;
  margin-bottom: 48rpx;
  position: relative;
  z-index: 1;
  max-width: 520rpx;
}

/* 快捷问题 - 欢迎卡片内 */
.quick-questions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.quick-q {
  background: var(--bg-tertiary);
  border: none;
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.quick-q::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary-color);
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.quick-q::after {
  content: '';
  position: absolute;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--text-muted);
  border-right: 3rpx solid var(--text-muted);
  transform: rotate(45deg);
  transition: all 0.25s ease;
}

.quick-q:active {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(37, 99, 235, 0.05) 100%);
  transform: scale(0.98);
}

.quick-q:active::before {
  transform: scale(1.2);
}

.quick-q:active::after {
  transform: rotate(45deg) translateX(4rpx);
  border-color: var(--primary-color);
}

/* ==================== 消息行 ==================== */
.message-wrapper {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  gap: 16rpx;
  animation: messageSlideIn 0.3s ease-out;
}

@keyframes messageSlideIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-side {
  flex-direction: row-reverse;
}

.ai-side {
  flex-direction: row;
}

/* ==================== 头像 ==================== */
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

.ai-avatar {
  background: var(--primary-gradient);
  box-shadow: var(--shadow-primary);
}

.ai-avatar-icon {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.user-avatar {
  background: linear-gradient(135deg, #64748b 0%, #475569 100%);
  color: #fff;
  box-shadow: 0 4px 12px rgba(71, 85, 105, 0.25);
}

/* ==================== 气泡 ==================== */
.bubble {
  max-width: 70%;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
  position: relative;
}

.bubble-ai {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border-bottom-left-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
}

.bubble-user {
  background: var(--primary-gradient);
  color: #fff;
  border-bottom-right-radius: var(--radius-sm);
  box-shadow: var(--shadow-primary);
}

/* ==================== 打字动画 ==================== */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 4rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-color);
  animation: typing-bounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing-bounce {
  0%, 60%, 100% { 
    transform: translateY(0) scale(1); 
    opacity: 0.4; 
  }
  30% { 
    transform: translateY(-10rpx) scale(1.1); 
    opacity: 1; 
  }
}

/* ==================== 内容块样式 ==================== */

/* 文本内容 */
.content-text {
  margin-bottom: 16rpx;
}

.content-text:last-child {
  margin-bottom: 0;
}

.content-text text {
  line-height: 1.8;
}

/* 富文本内容 */
.content-rich {
  margin-bottom: 16rpx;
}

.content-rich:last-child {
  margin-bottom: 0;
}

.rich-text {
  margin-bottom: 20rpx;
  line-height: 1.8;
}

.rich-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rich-image {
  width: 100%;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* ==================== 表单内容 ==================== */
.content-form {
  background: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-top: 16rpx;
}

.form-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.form-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  line-height: 1.6;
}

.form-fields {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.required {
  color: #ef4444;
  margin-left: 4rpx;
}

.field-input,
.field-textarea,
.field-picker {
  background: var(--bg-secondary);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  transition: all 0.2s ease;
}

.field-input:focus,
.field-textarea:focus {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.1);
}

.field-textarea {
  min-height: 140rpx;
  line-height: 1.6;
}

.picker-value {
  color: var(--text-muted);
}

.form-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.form-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-full);
  border: none;
  transition: all 0.2s ease;
}

.btn-primary {
  background: var(--primary-gradient);
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
}

.btn-default {
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border: 2rpx solid var(--border-color);
}

.btn-default:active {
  background: var(--bg-tertiary);
}

/* ==================== 列表内容 ==================== */
.content-list {
  margin-top: 16rpx;
}

.list-header {
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.list-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 20rpx;
  transition: all 0.2s ease;
}

.list-item:active {
  background: var(--border-color);
  transform: scale(0.99);
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  object-fit: cover;
  box-shadow: var(--shadow-sm);
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.item-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.item-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #ef4444;
  margin-top: 4rpx;
}

.item-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-muted);
  border-right: 3rpx solid var(--text-muted);
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-right: 8rpx;
}

.list-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary-color);
  text-align: center;
  font-weight: 500;
}

/* ==================== 转人工 ==================== */
.content-transfer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.transfer-icon {
  width: 96rpx;
  height: 96rpx;
  background: var(--accent-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4px 16px rgba(245, 158, 11, 0.3);
}

.icon-human {
  font-size: 40rpx;
}

.transfer-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.transfer-btn {
  background: var(--accent-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 48rpx;
  border-radius: var(--radius-full);
  border: none;
  box-shadow: 0 4px 16px rgba(245, 158, 11, 0.3);
  transition: all 0.2s ease;
}

.transfer-btn:active {
  transform: scale(0.98);
}

/* ==================== 错误提示 ==================== */
.content-error {
  padding: 16rpx 20rpx;
  background: #fef2f2;
  border-radius: var(--radius-md);
  border-left: 6rpx solid #ef4444;
}

.error-text {
  font-size: 26rpx;
  color: #dc2626;
  line-height: 1.6;
}

/* ==================== 用户发送的图片 ==================== */
.content-user-image {
  margin-top: 16rpx;
}

.user-image {
  max-width: 100%;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* ==================== 底部快捷问题栏 ==================== */
.quick-bar {
  background: var(--bg-secondary);
  border-top: 1rpx solid var(--border-color);
  padding: 20rpx 0;
  white-space: nowrap;
}

.quick-bar-list {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.quick-bar-item {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
  transition: all 0.2s ease;
  border: 1rpx solid transparent;
}

.quick-bar-item:active {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.15) 0%, rgba(37, 99, 235, 0.08) 100%);
  border-color: var(--primary-light);
  transform: scale(0.96);
}

/* ==================== 输入区域 ==================== */
.input-area {
  background: var(--bg-secondary);
  border-top: 1rpx solid var(--border-color);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 图片预览 */
.image-preview {
  display: flex;
  padding: 20rpx 28rpx 0;
  position: relative;
}

.preview-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-md);
  background: var(--bg-tertiary);
  object-fit: cover;
  box-shadow: var(--shadow-sm);
}

.remove-image {
  position: absolute;
  left: 148rpx;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.65);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.remove-image:active {
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.8);
}

.remove-image text {
  color: #fff;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

/* 添加图片按钮 */
.add-image-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-tertiary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid var(--border-color);
  transition: all 0.2s ease;
}

.add-image-btn:active {
  background: var(--border-color);
  transform: scale(0.95);
}

.add-icon {
  font-size: 44rpx;
  color: var(--text-muted);
  line-height: 1;
  font-weight: 300;
}

.input-box {
  flex: 1;
  min-height: 80rpx;
  max-height: 240rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-lg);
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input-box:focus {
  border-color: var(--primary-light);
  background: var(--bg-secondary);
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.08);
}

.input-placeholder {
  color: var(--text-muted);
  font-size: 28rpx;
}

/* 发送按钮 */
.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.send-active {
  background: var(--primary-gradient);
  box-shadow: var(--shadow-primary);
}

.send-active:active {
  transform: scale(0.92);
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
}

.send-disabled {
  background: var(--bg-tertiary);
  border: 2rpx solid var(--border-color);
}

.send-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 14rpx 0 14rpx 26rpx;
  border-color: transparent transparent transparent #fff;
  margin-left: 6rpx;
}

.send-disabled .send-icon {
  border-color: transparent transparent transparent var(--text-muted);
}

/* ==================== 滚动相关 ==================== */
#chat-bottom {
  height: 24rpx;
}
