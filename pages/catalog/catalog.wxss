page {
  height: 100%;
  background: #f5f7fa;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
}

.search-input {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-text {
  font-size: 26rpx;
  color: #999;
}

/* 分类主体 */
.catalog-main {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类导航 */
.category-nav {
  width: 180rpx;
  height: 100%;
  background: #fff;
  border-right: 1px solid #f0f0f0;
}

.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: #fafafa;
  border-bottom: 1px solid #f5f5f5;
  transition: all 0.3s;
}

.nav-item.active {
  background: #fff;
  border-bottom-color: #fff;
}

.nav-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 0 4rpx 4rpx 0;
}

.nav-text {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.3;
  padding: 0 8rpx;
}

.nav-item.active .nav-text {
  color: #1a73e8;
  font-weight: 600;
}

/* 右侧分类内容 */
.category-content {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 24rpx;
}

/* 顶部Banner */
.content-banner {
  position: relative;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(26, 115, 232, 0.85) 0%, rgba(13, 71, 161, 0.85) 100%);
}

.banner-info {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.banner-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 子分类标题 */
.sub-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.sub-line {
  width: 60rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #ddd 100%);
}

.sub-line:last-child {
  background: linear-gradient(90deg, #ddd 0%, transparent 100%);
}

.sub-title {
  font-size: 26rpx;
  color: #666;
}

/* 子分类网格 */
.sub-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.sub-item {
  width: calc((100% - 40rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sub-icon-wrapper {
  width: 140rpx;
  height: 140rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
  transition: all 0.3s;
}

.sub-icon-wrapper:active {
  transform: scale(0.95);
}

.sub-icon {
  width: 100%;
  height: 100%;
}

.sub-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  line-height: 1.3;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
