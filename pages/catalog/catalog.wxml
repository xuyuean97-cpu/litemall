<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <navigator url="/pages/search/search" class="search-input">
      <van-icon name="search" size="18px" color="#999" />
      <text class="search-text">搜索屏幕型号, 共{{goodsCount}}款物料</text>
    </navigator>
  </view>

  <!-- 分类主体 -->
  <view class="catalog-main">
    <!-- 左侧分类导航 -->
    <scroll-view class="category-nav" scroll-y="true">
      <view 
        class="nav-item {{ currentCategory.id == item.id ? 'active' : ''}}" 
        wx:for="{{categoryList}}" 
        wx:key="id" 
        data-id="{{item.id}}" 
        data-index="{{index}}" 
        bindtap="switchCate"
      >
        <view class="nav-indicator" wx:if="{{currentCategory.id == item.id}}"></view>
        <text class="nav-text">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧分类内容 -->
    <scroll-view class="category-content" scroll-y="true">
      <!-- 顶部分类Banner -->
      <view class="content-banner">
        <image class="banner-image" src="{{currentCategory.picUrl}}" mode="aspectFill"></image>
        <view class="banner-overlay"></view>
        <view class="banner-info">
          <text class="banner-title">{{currentCategory.name}}</text>
          <text class="banner-desc">{{currentCategory.frontName}}</text>
        </view>
      </view>

      <!-- 子分类标题 -->
      <view class="sub-header">
        <view class="sub-line"></view>
        <text class="sub-title">{{currentCategory.name}}分类</text>
        <view class="sub-line"></view>
      </view>

      <!-- 子分类网格 -->
      <view class="sub-grid">
        <navigator 
          url="/pages/category/category?id={{item.id}}" 
          class="sub-item" 
          wx:key="id" 
          wx:for="{{currentSubCategoryList}}"
        >
          <view class="sub-icon-wrapper">
            <image class="sub-icon" src="{{item.picUrl}}" mode="aspectFill"></image>
          </view>
          <text class="sub-name">{{item.name}}</text>
        </navigator>
      </view>
    </scroll-view>
  </view>
</view>
