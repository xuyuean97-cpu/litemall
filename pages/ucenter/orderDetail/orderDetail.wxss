page {
  height: 100%;
  width: 100%;
  background: #f5f5f5;
}

.container {
  padding: 20rpx 24rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* 订单信息卡片 */
.order-info {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.order-info .item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-info .item:last-of-type {
  border-bottom: none;
}

.order-info .item .label {
  font-size: 28rpx;
  color: #666;
}

.order-info .item .txt {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

/* 操作按钮区域 */
.item-c {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
}

.item-c .r {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.item-c .btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  text-align: center;
  background: #f5f5f5;
  color: #666;
}

.item-c .btn.active {
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(171, 149, 109, 0.3);
}

/* 商品信息卡片 */
.order-goods {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.order-goods .h {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-goods .h .label {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.order-goods .h .status {
  font-size: 26rpx;
  color: #ab956d;
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: rgba(171, 149, 109, 0.1);
  border-radius: 20rpx;
}

/* 商品列表 */
.order-goods .goods {
  padding: 12rpx 0;
}

.order-goods .item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-goods .item:last-child {
  border-bottom: none;
}

.order-goods .item .img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #f8f8f8;
  overflow: hidden;
  flex-shrink: 0;
}

.order-goods .item .img image {
  width: 140rpx;
  height: 140rpx;
}

.order-goods .item .info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.order-goods .item .t {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.order-goods .item .t .name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order-goods .item .t .number {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.order-goods .item .attr {
  font-size: 24rpx;
  color: #999;
  background: #f8f8f8;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-bottom: 12rpx;
  align-self: flex-start;
}

.order-goods .item .price {
  font-size: 30rpx;
  color: #ab956d;
  font-weight: 600;
}

.order-goods .item .btn {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  color: #666;
}

.order-goods .item .btn.active {
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  color: #fff;
  font-weight: 500;
}

.order-goods .item .btn.active navigator {
  color: #fff;
}

/* 订单底部信息 */
.order-bottom {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  padding: 0;
}

/* 收货地址 */
.order-bottom .address {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-bottom .address .t {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-bottom .address .t .name {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.order-bottom .address .t .mobile {
  font-size: 28rpx;
  color: #666;
}

.order-bottom .address .b {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

/* 费用明细 */
.order-bottom .total {
  padding: 12rpx 28rpx;
}

.order-bottom .total .t {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-bottom .total .t:last-child {
  border-bottom: none;
}

.order-bottom .total .t .label {
  font-size: 28rpx;
  color: #666;
}

.order-bottom .total .t .txt {
  font-size: 28rpx;
  color: #333;
}

.order-bottom .total .t:last-child .txt {
  color: #ab956d;
  font-weight: 600;
  font-size: 32rpx;
}

/* 物流信息卡片 */
.order-express {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
  padding: 0;
}

.order-express .order-express {
  margin-top: 0;
  box-shadow: none;
  border-radius: 0;
}

.order-express .title {
  flex: 1;
  padding: 24rpx 28rpx;
}

.order-express .ti {
  width: 60rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order-express .t {
  font-size: 28rpx;
  color: #ab956d;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.order-express .b {
  font-size: 26rpx;
  color: #999;
}

/* 物流轨迹 */
.order-express .traces {
  padding: 0 28rpx;
  border-top: 1rpx solid #f5f5f5;
}

.order-express .trace {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
  padding-left: 24rpx;
}

.order-express .trace::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ab956d;
}

.order-express .trace:last-child {
  border-bottom: none;
}

.order-express .trace:first-child::before {
  background: linear-gradient(135deg, #ab956d 0%, #D4AF37 100%);
  box-shadow: 0 0 0 4rpx rgba(171, 149, 109, 0.2);
}

.order-express .acceptStation {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.order-express .acceptTime {
  font-size: 24rpx;
  color: #999;
}
