page {
  height: 100%;
  width: 100%;
  background: #f5f5f5;
}

/* 订单状态切换栏 */
.orders-switch {
  width: 100%;
  background: #fff;
  height: 96rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: sticky;
  top: 0;
  z-index: 100;
}

.orders-switch .item {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orders-switch .item .txt {
  height: 96rpx;
  line-height: 96rpx;
  color: #666;
  font-size: 28rpx;
  padding: 0 8rpx;
  position: relative;
  transition: all 0.3s;
}

.orders-switch .item.active .txt {
  color: #ab956d;
  font-weight: 600;
}

.orders-switch .item.active .txt::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  border-radius: 3rpx;
}

/* 空订单状态 */
.no-order {
  width: 100%;
  height: auto;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.no-order .c {
  width: 100%;
  height: auto;
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.no-order .c text {
  display: block;
  text-align: center;
  font-size: 30rpx;
  color: #999;
}

/* 订单列表 */
.orders {
  height: auto;
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* 订单卡片 */
.order {
  display: block;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* 订单头部 */
.order .h {
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order .h .l {
  font-size: 26rpx;
  color: #999;
}

.order .h .r {
  font-size: 26rpx;
  color: #ab956d;
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: rgba(171, 149, 109, 0.1);
  border-radius: 20rpx;
}

/* 商品信息 */
.order .goods {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.order .goods .img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8f8f8;
  flex-shrink: 0;
}

.order .goods .img image {
  width: 160rpx;
  height: 160rpx;
}

.order .goods .info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.order .goods .name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order .goods .number {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.order .goods .status {
  width: 80rpx;
  font-size: 24rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 订单底部 */
.order .b {
  height: 96rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 28rpx;
  border-top: 1rpx solid #f5f5f5;
  background: #fafafa;
}

.order .b .l {
  font-size: 28rpx;
  color: #333;
}

.order .b .l text {
  color: #ab956d;
  font-weight: 600;
  font-size: 32rpx;
}

.order .b .r {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order .b .btn {
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  padding: 0 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #ab956d 0%, #c9b896 100%);
  font-weight: 500;
}

.order .b .btn:active {
  opacity: 0.9;
}

/* 多商品时的样式调整 */
.order .goods + .goods {
  padding-top: 0;
  border-top: 1rpx dashed #f0f0f0;
  margin-top: 0;
}
