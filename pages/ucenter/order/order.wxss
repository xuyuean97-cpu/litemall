page {
  height: 100%;
  width: 100%;
  background: #f5f7fa;
}

.container {
  min-height: 100%;
  background: #f5f7fa;
}

/* 订单标签页 */
.order-tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #1a73e8;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-radius: 3rpx;
}

/* 空订单状态 */
.empty-order {
  padding-top: 200rpx;
}

.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-text {
  font-size: 30rpx;
  color: #333;
  margin-top: 32rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f5f7fa;
}

.order-sn {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sn-text {
  font-size: 24rpx;
  color: #666;
}

.order-status {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a73e8;
}

.order-status.status-pending {
  color: #f5a623;
}

.order-status.status-shipping {
  color: #1a73e8;
}

.order-status.status-receiving {
  color: #52c41a;
}

/* 商品信息 */
.order-goods {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #f5f7fa;
}

.order-goods:last-of-type {
  border-bottom: none;
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fafbfc;
}

.order-total {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
}

.total-price {
  font-size: 32rpx;
  color: #1a73e8;
  font-weight: 700;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 16rpx;
  margin-left: auto;
  padding-left: 24rpx;
}

.action-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}
