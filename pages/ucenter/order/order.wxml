<view class="container">
  <!-- 订单状态标签页 -->
  <view class="order-tabs">
    <view class="tab-item {{ showType == 0 ? 'active' : ''}}" bindtap="switchTab" data-index='0'>
      <text class="tab-text">全部</text>
      <view class="tab-indicator" wx:if="{{showType == 0}}"></view>
    </view>
    <view class="tab-item {{ showType == 1 ? 'active' : ''}}" bindtap="switchTab" data-index='1'>
      <text class="tab-text">待付款</text>
      <view class="tab-indicator" wx:if="{{showType == 1}}"></view>
    </view>
    <view class="tab-item {{ showType == 2 ? 'active' : ''}}" bindtap="switchTab" data-index='2'>
      <text class="tab-text">待发货</text>
      <view class="tab-indicator" wx:if="{{showType == 2}}"></view>
    </view>
    <view class="tab-item {{ showType == 3 ? 'active' : ''}}" bindtap="switchTab" data-index='3'>
      <text class="tab-text">待收货</text>
      <view class="tab-indicator" wx:if="{{showType == 3}}"></view>
    </view>
    <view class="tab-item {{ showType == 4 ? 'active' : ''}}" bindtap="switchTab" data-index='4'>
      <text class="tab-text">待评价</text>
      <view class="tab-indicator" wx:if="{{showType == 4}}"></view>
    </view>
  </view>

  <!-- 空订单状态 -->
  <view class="empty-order" wx:if="{{orderList.length <= 0}}">
    <view class="empty-content">
      <van-icon name="orders-o" size="120rpx" color="#ddd" />
      <text class="empty-text">还没有任何订单呢</text>
      <text class="empty-hint">快去选购心仪的商品吧</text>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:else>
    <navigator url="../orderDetail/orderDetail?id={{item.id}}" class="order-card" open-type="redirect" wx:for="{{orderList}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-header">
        <view class="order-sn">
          <van-icon name="orders-o" size="28rpx" color="#999" />
          <text class="sn-text">{{item.orderSn}}</text>
        </view>
        <view class="order-status {{item.orderStatusText == '待付款' ? 'status-pending' : item.orderStatusText == '待发货' ? 'status-shipping' : item.orderStatusText == '待收货' ? 'status-receiving' : ''}}">
          {{item.orderStatusText}}
        </view>
      </view>

      <!-- 商品列表 -->
      <view class="order-goods" wx:for="{{item.goodsList}}" wx:key="id" wx:for-item="gitem">
        <image class="goods-img" src="{{gitem.picUrl}}" mode="aspectFill"></image>
        <view class="goods-info">
          <text class="goods-name">{{gitem.goodsName}}</text>
          <text class="goods-count">共{{gitem.number}}件商品</text>
        </view>
        <van-icon name="arrow" size="28rpx" color="#ccc" />
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-total">
          <text class="total-label">实付款：</text>
          <text class="total-price">¥{{item.actualPrice}}</text>
        </view>
      </view>
    </navigator>
  </view>
</view>
