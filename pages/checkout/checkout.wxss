page {
  height: 100%;
  background: #f5f5f5;
}

.container {
  padding: 20rpx 24rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 地址卡片 */
.address-box {
  width: 100%;
  height: auto;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.address-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  position: relative;
}

.address-item::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: repeating-linear-gradient(
    90deg,
    #ab956d 0,
    #ab956d 10rpx,
    #c9b896 10rpx,
    #c9b896 20rpx,
    #f5deb3 20rpx,
    #f5deb3 30rpx
  );
}

.address-item.address-empty {
  justify-content: center;
  padding: 40rpx 28rpx;
}

.address-item.address-empty .m {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.address-box .l {
  width: 140rpx;
  flex-shrink: 0;
}

.address-box .l .name {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.address-box .l .default {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, rgba(171, 149, 109, 0.15) 0%, rgba(201, 184, 150, 0.1) 100%);
  border: 1rpx solid #ab956d;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #ab956d;
  font-weight: 500;
}

.address-box .m {
  flex: 1;
  padding-right: 20rpx;
}

.address-box .mobile {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.address-box .address {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.address-box .r {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* 优惠券卡片 */
.coupon-box {
  width: 100%;
  height: auto;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.coupon-box .coupon-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.coupon-box .l {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-box .l .name {
  font-size: 28rpx;
  color: #333;
}

.coupon-box .l .txt {
  font-size: 28rpx;
  color: #ab956d;
  font-weight: 500;
}

.coupon-box .r {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* 留言输入框 */
.message-box {
  width: 100%;
  height: auto;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.message-box .message-item {
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.message-box .message-item::placeholder {
  color: #ccc;
}

/* 订单金额卡片 */
.order-box {
  width: 100%;
  height: auto;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.order-box .order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-box .order-item.no-border {
  border-bottom: none;
}

.order-box .order-item .l .name {
  font-size: 28rpx;
  color: #666;
}

.order-box .order-item .r .txt {
  font-size: 28rpx;
  color: #333;
}

.order-box .order-item:last-child .r .txt {
  color: #ab956d;
  font-weight: 500;
}

/* 商品列表卡片 */
.goods-items {
  width: 100%;
  height: auto;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  padding: 12rpx 0;
  overflow: hidden;
}

.goods-items .item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-items .item:last-child {
  border-bottom: none;
}

.goods-items .img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background-color: #f8f8f8;
  overflow: hidden;
  flex-shrink: 0;
}

.goods-items .img image {
  width: 140rpx;
  height: 140rpx;
}

.goods-items .info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-items .t {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.goods-items .t .name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-items .t .number {
  font-size: 26rpx;
  color: #999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.goods-items .m {
  font-size: 24rpx;
  color: #999;
  background: #f8f8f8;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-bottom: 12rpx;
  align-self: flex-start;
}

.goods-items .b {
  font-size: 30rpx;
  color: #ab956d;
  font-weight: 600;
}

/* 底部结算栏 */
.order-total {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  display: flex;
  align-items: center;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.order-total .l {
  flex: 1;
  padding-left: 28rpx;
  font-size: 28rpx;
  color: #333;
}

.order-total .l text {
  font-size: 36rpx;
  color: #ab956d;
  font-weight: 700;
}

.order-total .r {
  width: 260rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ab956d 0%, #8B6914 100%);
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.order-total .r:active {
  opacity: 0.9;
}
