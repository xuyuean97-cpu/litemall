<!-- index.wxml - 笔记本屏幕物料销售首页 -->
<view class="container">

<!-- 搜索栏 -->
<view class="search-header">
    <navigator url="/pages/search/search" class="search-input">
        <van-icon name="search" size="18px" color="#999" />
        <text class="search-txt">输入屏幕型号，如 NV156FHM-N61</text>
    </navigator>
</view>

<!-- 顶部抬头 - 专业定位 -->
<view class="hero-header">
    <view class="hero-content">
        <view class="hero-main">
            <text class="hero-title">笔记本屏幕物料</text>
            <text class="hero-subtitle">维修师傅专属采购平台</text>
        </view>
        <view class="hero-tags">
            <view class="hero-tag">
                <van-icon name="certificate" size="14px" color="#fff" />
                <text>原厂品质</text>
            </view>
            <view class="hero-tag">
                <van-icon name="logistics" size="14px" color="#fff" />
                <text>闪电发货</text>
            </view>
            <view class="hero-tag">
                <van-icon name="gold-coin-o" size="14px" color="#fff" />
                <text>批发价格</text>
            </view>
        </view>
    </view>
    <view class="hero-stats">
        <view class="stat-item">
            <text class="stat-num">100+</text>
            <text class="stat-label">屏幕型号</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
            <text class="stat-num">当日</text>
            <text class="stat-label">发货时效</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
            <text class="stat-num">质保</text>
            <text class="stat-label">售后无忧</text>
        </view>
    </view>
</view>

<!-- 品牌 -->
<view class="brand-nav" wx:if="{{screenBrands.length > 0}}">
    <view class="brand-title">
        <text class="title-txt">屏幕品牌</text>
        <navigator url="/pages/brand/brand" class="more-link">
            <text>全部</text>
            <van-icon name="arrow" size="12px" />
        </navigator>
    </view>

    <scroll-view scroll-x class="brand-scroll" enhanced show-scrollbar="{{false}}">
        <view class="brand-list">
            <navigator class="brand-item"
                       wx:for="{{screenBrands}}"
                       wx:key="id"
                       url="/pages/brandDetail/brandDetail?id={{item.id}}">
                
                <view class="brand-icon" style="background-color: {{item.bgColor}}">
                  <image wx:if="{{item.picUrl}}" src="{{item.picUrl}}" mode="aspectFit" />
                    <text wx:else class="brand-abbr">{{item.abbr}}</text>
                </view>

                <text class="brand-name">{{item.name}}</text>
            </navigator>
        </view>
    </scroll-view>
</view>

<!-- 筛选区域 -->
<view class="filter-section">
    <!-- 筛选面板头部：标题与收起/展开按钮 -->
    <view class="filter-header">
        <view class="filter-header-left">
            <van-icon name="filter-o" size="16px" color="#333" />
            <text class="filter-header-title">参数筛选</text>
        </view>
        <view class="filter-toggle" bindtap="toggleFilter">
            <text>{{isFilterExpanded ? '收起筛选' : '展开筛选'}}</text>
            <van-icon name="{{isFilterExpanded ? 'arrow-up' : 'arrow-down'}}" size="12px" color="#666" />
        </view>
    </view>

    <!-- 筛选条件内容区 (根据开关状态显示/隐藏) -->
    <view class="filter-content" wx:if="{{isFilterExpanded}}">
        
        <!-- 尺寸维度 -->
        <view class="filter-row" wx:if="{{sizeCategories.length > 1}}">
            <view class="filter-label">尺寸</view>
            <!-- ⬇️ 这里改成了 scroll-view -->
            <scroll-view scroll-x class="filter-options" enhanced show-scrollbar="{{false}}">
                <view class="filter-tag {{currentSizeId === item.id ? 'active' : ''}}"
                      wx:for="{{sizeCategories}}"
                      wx:key="id"
                      bindtap="onSizeFilter"
                      data-id="{{item.id}}"
                      data-name="{{item.name}}">
                    {{item.name}}
                </view>
            </scroll-view>
        </view>

        <!-- 面板维度 -->
        <view class="filter-row" wx:if="{{panelCategories.length > 1}}">
            <view class="filter-label">类型</view>
            <!-- ⬇️ 这里改成了 scroll-view -->
            <scroll-view scroll-x class="filter-options" enhanced show-scrollbar="{{false}}">
                <view class="filter-tag {{currentPanelId === item.id ? 'active' : ''}}"
                      wx:for="{{panelCategories}}"
                      wx:key="id"
                      bindtap="onPanelTypeFilter"
                      data-id="{{item.id}}"
                      data-name="{{item.name}}">
                    {{item.name}}
                </view>
            </scroll-view>
        </view>
        <!-- 分辨率维度 -->
        <view class="filter-row" wx:if="{{resolutionCategories.length > 1}}">
            <view class="filter-label">分辨率</view>
            <scroll-view scroll-x class="filter-options" enhanced show-scrollbar="{{false}}">
                <view class="filter-tag {{currentResolutionId === item.id ? 'active' : ''}}"
                      wx:for="{{resolutionCategories}}"
                      wx:key="id"
                      bindtap="onResolutionFilter"
                      data-id="{{item.id}}">
                    {{item.name}}
                </view>
            </scroll-view>
        </view>

        <!-- 刷新率维度 -->
        <view class="filter-row" wx:if="{{refreshRateCategories.length > 1}}">
            <view class="filter-label">刷新率</view>
            <scroll-view scroll-x class="filter-options" enhanced show-scrollbar="{{false}}">
                <view class="filter-tag {{currentRefreshRateId === item.id ? 'active' : ''}}"
                      wx:for="{{refreshRateCategories}}"
                      wx:key="id"
                      bindtap="onRefreshRateFilter"
                      data-id="{{item.id}}">
                    {{item.name}}
                </view>
            </scroll-view>
        </view>

        <!-- 亮度维度 -->
        <view class="filter-row" wx:if="{{brightnessCategories.length > 1}}">
            <view class="filter-label">亮度</view>
            <scroll-view scroll-x class="filter-options" enhanced show-scrollbar="{{false}}">
                <view class="filter-tag {{currentBrightnessId === item.id ? 'active' : ''}}"
                      wx:for="{{brightnessCategories}}"
                      wx:key="id"
                      bindtap="onBrightnessFilter"
                      data-id="{{item.id}}">
                    {{item.name}}
                </view>
            </scroll-view>
        </view>
    </view>
</view>

<!-- 筛选结果商品列表 -->
<view class="section goods-section">
    <view class="section-header">
        <view class="header-left">
            <view class="header-icon filter-icon"></view>
            <text class="header-title">
                <block wx:if="{{currentSizeId > 0 || currentPanelId > 0}}">
                    筛选结果
                    <text class="filter-condition">
                        （<block wx:if="{{currentSizeId > 0}}">{{currentSizeName}}</block><block wx:if="{{currentSizeId > 0 && currentPanelId > 0}}"> + </block><block wx:if="{{currentPanelId > 0}}">{{currentPanelName}}</block>）
                    </text>
                </block>
                <block wx:else>全部商品</block>
            </text>
        </view>
    </view>

    <!-- 商品列表 -->
    <view class="goods-list" wx:if="{{goodsList.length > 0}}">
        <view class="goods-card" wx:for="{{goodsList}}" wx:key="id">
            <navigator url="/pages/goods/goods?id={{item.id}}" class="goods-link">
                <view class="goods-img-wrap">
                    <image class="goods-img" src="{{item.picUrl}}" mode="aspectFill"></image>
                </view>
                <view class="goods-info">
                    <text class="goods-model">{{item.model || item.name}}</text>
                    <text class="goods-price">¥{{item.retailPrice}}</text>
                </view>
            </navigator>
        </view>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
        <text>加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{finished && goodsList.length > 0}}">
        <text>没有更多了</text>
    </view>

    <!-- 无结果 -->
    <view class="no-result" wx:if="{{goodsList.length === 0 && !loading}}">
        <text>暂无商品</text>
    </view>
</view>

<!-- 阶梯定价 -->
<view class="price-tier-banner">
    <view class="tier-header">
        <van-icon name="gold-coin-o" size="18px" color="#f5a623" />
        <text class="tier-title">认证会员购买更优惠</text>
    </view>

    <view class="tier-content">
        <view class="tier-item">
            <text class="tier-qty">普通用户</text>
            <text class="tier-label">零售价</text>
        </view>

        <view class="tier-divider"></view>

        <view class="tier-item">
            <text class="tier-qty">认证会员</text>
            <text class="tier-discount">批发价</text>
        </view>

        <view class="tier-divider"></view>

        <view class="tier-item">
            <text class="tier-qty">购买10次以上</text>
            <text class="tier-discount">9折</text>
        </view>
    </view>
</view>

<!-- 热销商品 -->
<view class="section" wx:if="{{hotGoods.length > 0}}">
    <view class="section-header">
        <view class="header-left">
            <view class="header-icon hot-icon"></view>
            <text class="header-title">热销型号</text>
        </view>

        <navigator url="/pages/hotGoods/hotGoods" class="header-more">
            <text>查看更多</text>
            <van-icon name="arrow" size="12px" />
        </navigator>
    </view>

    <view class="goods-list">
        <view class="goods-card" wx:for="{{hotGoods}}" wx:key="id">
            <navigator url="/pages/goods/goods?id={{item.id}}" class="goods-link">

                <view class="goods-img-wrap">
                    <image class="goods-img" src="{{item.picUrl}}" mode="aspectFill"></image>
                    <view class="stock-tag {{item.stock > 0 ? 'in-stock' : 'out-stock'}}">
                        {{item.stock > 0 ? '现货' : '缺货'}}
                    </view>
                </view>

                <view class="goods-info">

                    <text class="goods-model">{{item.model || item.name}}</text>

                    <!-- 真实规格 -->
                    <view class="goods-spec">

                        <block wx:if="{{item.size}}">
                            <text class="spec-item">{{item.size}}寸</text>
                        </block>

                        <block wx:if="{{item.resolution}}">
                            <text class="spec-divider">|</text>
                            <text class="spec-item">{{item.resolution}}</text>
                        </block>

                        <block wx:if="{{item.panelType}}">
                            <text class="spec-divider">|</text>
                            <text class="spec-item">{{item.panelType}}</text>
                        </block>

                    </view>

                    <text class="goods-compatible" wx:if="{{item.compatible}}">
                        适配: {{item.compatible}}
                    </text>

                    <view class="goods-price-row">
                        <text class="goods-price">¥{{item.retailPrice}}</text>
                        <text class="tier-hint" wx:if="{{item.hasTierPrice}}">10+更优惠</text>
                    </view>

                </view>
            </navigator>
        </view>
    </view>
</view>

<!-- 新品 -->
<view class="section" wx:if="{{newGoods.length > 0}}">
    <view class="section-header">
        <view class="header-left">
            <view class="header-icon new-icon"></view>
            <text class="header-title">新到货物料</text>
        </view>

        <navigator url="/pages/newGoods/newGoods" class="header-more">
            <text>查看更多</text>
            <van-icon name="arrow" size="12px" />
        </navigator>
    </view>

    <scroll-view scroll-x class="goods-scroll" enhanced show-scrollbar="{{false}}">
        <view class="goods-scroll-list">

            <view class="goods-scroll-item" wx:for="{{newGoods}}" wx:key="id">
                <navigator url="/pages/goods/goods?id={{item.id}}">
                    <image class="scroll-img" src="{{item.picUrl}}" mode="aspectFill"></image>

                    <text class="scroll-model">{{item.model || item.name}}</text>

                    <!-- 新品规格 -->
                    <text class="scroll-spec">
                        <block wx:if="{{item.size}}">
                            {{item.size}}寸
                        </block>
                        <block wx:if="{{item.panelType}}">
                            {{item.panelType}}
                        </block>
                    </text>

                    <text class="scroll-price">¥{{item.retailPrice}}</text>
                </navigator>
            </view>

        </view>
    </scroll-view>
</view>

<!-- 楼层 -->
<view class="brand-floor" wx:for="{{floorGoods}}" wx:key="id" wx:if="{{item.goodsList.length > 0}}">

    <view class="floor-header">
        <view class="floor-brand">
            <text class="floor-brand-name">{{item.name}}</text>
            <text class="floor-brand-count">{{item.goodsList.length}}款</text>
        </view>

        <navigator url="/pages/category/category?id={{item.id}}" class="floor-more">
            <text>更多</text>
            <van-icon name="arrow" size="12px" />
        </navigator>
    </view>

    <view class="floor-goods">
        <view class="floor-goods-item" wx:for="{{item.goodsList}}" wx:key="id">
            <navigator url="/pages/goods/goods?id={{item.id}}">

                <image class="floor-goods-img" src="{{item.picUrl}}" mode="aspectFill"></image>

                <view class="floor-goods-info">
                    <text class="floor-goods-model">{{item.model || item.name}}</text>

                    <text class="floor-goods-spec">
                        <block wx:if="{{item.size}}">
                            {{item.size}}寸
                        </block>

                        <block wx:if="{{item.resolution}}">
                            | {{item.resolution}}
                        </block>
                    </text>

                    <text class="floor-goods-price">¥{{item.retailPrice}}</text>
                </view>

            </navigator>
        </view>
    </view>

</view>

<!-- 缺货登记 -->
<view class="shortage-entry">
    <navigator url="/pages/shortage/shortage" class="shortage-link">
        <van-icon name="bell-o" size="20px" color="#1a73e8" />
        <view class="shortage-text">
            <text class="shortage-title">找不到需要的型号？</text>
            <text class="shortage-desc">提交缺货登记，到货通知</text>
        </view>
        <van-icon name="arrow" size="14px" color="#999" />
    </navigator>
</view>

<view class="safe-bottom"></view>
<!-- AI 客服悬浮按钮 -->
<view class="ai-float-btn" bindtap="openAiChat">
  <view class="ai-float-icon">
    <view class="ai-dot dot1"></view>
    <view class="ai-dot dot2"></view>
    <view class="ai-dot dot3"></view>
  </view>
  <text class="ai-float-label">AI查屏</text>
</view>
</view>
