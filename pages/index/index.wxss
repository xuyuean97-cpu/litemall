/* index.wxss - 笔记本屏幕物料销售首页样式 */

/* 基础容器 */
.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 搜索栏 */
.search-header {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #1a73e8 0%, #1557b0 100%);
}

.search-input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-txt {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #999;
}

/* 轮播图 */
.banner {
  width: 100%;
  height: 300rpx;
}

.banner image {
  width: 100%;
  height: 100%;
}

/* 屏幕品牌导航 */
.brand-nav {
  background: #fff;
  padding: 24rpx 0;
  margin-top: 16rpx;
}

.brand-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 20rpx;
}

.title-txt {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.more-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.brand-scroll {
  width: 100%;
}

.brand-list {
  display: flex;
  padding: 0 24rpx;
  white-space: nowrap;
}

.brand-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.brand-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f5ff;
  margin-bottom: 12rpx;
}

.brand-icon image {
  width: 64rpx;
  height: 64rpx;
}

.brand-abbr {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a73e8;
}

.brand-name {
  font-size: 24rpx;
  color: #333;
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* 快捷筛选 */
.quick-filter {
  background: #fff;
  padding: 20rpx 0;
  margin-top: 2rpx;
}

.filter-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  padding: 0 24rpx 16rpx;
}

.filter-scroll {
  width: 100%;
}

.filter-tags {
  display: flex;
  padding: 0 24rpx;
  white-space: nowrap;
}

.filter-tag {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.filter-tag.active {
  color: #1a73e8;
  background: #e8f0fe;
  border-color: #1a73e8;
}

/* 筛选结果区域 */
.filter-result {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.filter-result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 24rpx 16rpx;
}

.result-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a73e8;
}

.result-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #1a73e8;
}

.result-count {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多按钮 */
.load-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 188rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #1a73e8;
}

/* 已加载全部提示 */
.no-more-hint {
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* 无结果提示 */
.no-result {
  text-align: center;
  padding: 32rpx 24rpx;
  font-size: 26rpx;
  color: #999;
}

/* 筛选加载中 */
.filter-loading {
  text-align: center;
  padding: 32rpx 24rpx;
  font-size: 26rpx;
  color: #999;
}

/* 阶梯报价说明 */
.price-tier-banner {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 16rpx;
  border: 2rpx solid #fcd34d;
}

.tier-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tier-title {
  margin-left: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
}

.tier-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tier-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tier-qty {
  font-size: 24rpx;
  color: #78716c;
  margin-bottom: 6rpx;
}

.tier-label {
  font-size: 26rpx;
  color: #a16207;
}

.tier-discount {
  font-size: 28rpx;
  font-weight: 600;
  color: #dc2626;
}

.tier-divider {
  width: 2rpx;
  height: 48rpx;
  background: #fcd34d;
}

/* 通用 section 样式 */
.section {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-icon {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.hot-icon {
  background: linear-gradient(180deg, #ff6b6b 0%, #ee5a24 100%);
}

.new-icon {
  background: linear-gradient(180deg, #4ecdc4 0%, #2ecc71 100%);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.header-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

/* 商品列表 - 热销型号 */
.goods-list {
  display: flex;
  flex-direction: column;
}

.goods-card {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #f0f0f0;
  overflow: hidden;
}

.goods-card:last-child {
  margin-bottom: 0;
}

.goods-link {
  display: flex;
  padding: 20rpx;
}

.goods-img-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.goods-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.stock-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 4rpx;
}

.stock-tag.in-stock {
  background: rgba(34, 197, 94, 0.9);
  color: #fff;
}

.stock-tag.out-stock {
  background: rgba(239, 68, 68, 0.9);
  color: #fff;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.goods-model {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.spec-item {
  font-size: 24rpx;
  color: #666;
}

.spec-divider {
  margin: 0 8rpx;
  color: #ddd;
  font-size: 20rpx;
}

.goods-compatible {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 600;
  color: #dc2626;
}

.tier-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #f97316;
  background: #fff7ed;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* 横向滚动商品 - 新到货 */
.goods-scroll {
  margin: 0 -24rpx;
  padding: 0 24rpx;
}

.goods-scroll-list {
  display: flex;
  padding-right: 24rpx;
}

.goods-scroll-item {
  width: 220rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 16rpx;
}

.scroll-img {
  width: 188rpx;
  height: 188rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.scroll-model {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scroll-spec {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.scroll-price {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #dc2626;
  margin-top: 8rpx;
}

/* 品牌楼层 */
.brand-floor {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx;
}

.floor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.floor-brand {
  display: flex;
  align-items: baseline;
}

.floor-brand-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.floor-brand-count {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.floor-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.floor-goods {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.floor-goods-item {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
}

.floor-goods-img {
  width: 100%;
  height: 260rpx;
  background: #f0f0f0;
}

.floor-goods-info {
  padding: 16rpx;
}

.floor-goods-model {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.floor-goods-spec {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.floor-goods-price {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #dc2626;
  margin-top: 10rpx;
}

/* 缺货登记入口 */
.shortage-entry {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.shortage-link {
  display: flex;
  align-items: center;
}

.shortage-text {
  flex: 1;
  margin-left: 16rpx;
}

.shortage-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.shortage-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 底部安全区 */
.safe-bottom {
  height: 120rpx;
}
